# Copia este archivo a ".env" en este mismo directorio y pon valores reales.
# El ".env" NO se sube a git (ver .gitignore) - solo vive en cada maquina/servidor.
# Sin un ".env", docker-compose usa los valores de desarrollo por defecto
# (los mismos que ya corren localmente hoy).

# Contrasena del usuario root de MySQL (administracion del servidor de BD)
MYSQL_ROOT_PASSWORD=cambia-esto-por-una-contrasena-fuerte

# Usuario/contrasena dedicados para que los 4 servicios Java se conecten a
# sus bases de datos (no root) - se crea automaticamente la primera vez que
# arranca el volumen de MySQL.
MYSQL_APP_USER=aitel_app
MYSQL_APP_PASSWORD=cambia-esto-tambien

# Clave usada para firmar/validar los JWT de sesion. Debe ser la MISMA en
# usuarios-service y gateway-service (docker-compose ya la comparte entre
# ambos automaticamente a traves de esta unica variable).
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
